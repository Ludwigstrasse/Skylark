    {
      "name": "windows-cadeditor-vulkan",
      "inherits": "windows-vulkan",
      "cacheVariables": {
        "SK_BUILD_CAD_EDITOR_LAB": "ON",
        "VCPKG_MANIFEST_FEATURES": "vulkan;cadscene-runtime-test"
      }
    },
    {
      "name": "windows-cadeditor-vulkan-vs2022",
      "inherits": "windows-vs2022",
      "cacheVariables": {
        "SK_ENABLE_VULKAN": "ON",
        "SK_BUILD_CAD_EDITOR_LAB": "ON",
        "VCPKG_MANIFEST_FEATURES": "vulkan;cadscene-runtime-test"
      }
    },
    {
      "name": "windows-cadscene",
      "inherits": "windows-opengl",
      "cacheVariables": {
        "SK_BUILD_CADSCENE_TEST_APP": "ON",
        "VCPKG_MANIFEST_FEATURES": "opengl;cadscene-test"
      }
    },
    {
      "name": "windows-cadscene-opengl",
      "inherits": "windows-opengl",
      "cacheVariables": {
        "SK_BUILD_CADSCENE_TEST_APP": "ON",
        "VCPKG_MANIFEST_FEATURES": "opengl;cadscene-test"
      }
    },
    {
      "name": "windows-cadscene-opengl-vs2022",
      "inherits": "windows-vs2022",
      "cacheVariables": {
        "SK_ENABLE_OPENGL": "ON",
        "SK_BUILD_CADSCENE_TEST_APP": "ON",
        "VCPKG_MANIFEST_FEATURES": "opengl;cadscene-test"
      }
    },
    {
      "name": "windows-d3d11",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "SK_ENABLE_D3D11": "ON"
      }
    },
    {
      "name": "windows-d3d12",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "SK_ENABLE_D3D12": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base-vcpkg",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "SK_BUILD_SMOKE_TEST": "ON"
      }
    },
    {
      "name": "windows-opengl",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "SK_ENABLE_OPENGL": "ON",
        "VCPKG_MANIFEST_FEATURES": "opengl"
      }
    },
    {
      "name": "windows-vs2022",
      "inherits": "base-vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
