{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SK_BUILD_INSTALL": "ON",
        "SK_BUILD_LEGACY": "OFF",
        "SK_ENABLE_WARNINGS_AS_ERRORS": "OFF",
        "SK_ENABLE_D3D11": "OFF",
        "SK_ENABLE_D3D12": "OFF",
        "SK_ENABLE_OPENGL": "OFF",
        "SK_ENABLE_VULKAN": "OFF"
      }
    },
    {
      "name": "base-vcpkg",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "dev-linux-debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SK_BUILD_SMOKE_TEST": "ON"
      }
    },
    {
      "name": "dev-linux-release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-cadscene-debug",
      "inherits": "linux-opengl-debug",
      "cacheVariables": {
        "SK_BUILD_CADSCENE_TEST_APP": "ON",
        "VCPKG_MANIFEST_FEATURES": "opengl;cadscene-test"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SK_BUILD_SMOKE_TEST": "ON"
      }
    },
    {
      "name": "linux-opengl-debug",
      "inherits": "linux-debug",
      "cacheVariables": {
        "SK_ENABLE_OPENGL": "ON",
        "VCPKG_MANIFEST_FEATURES": "opengl"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-vulkan-debug",
      "inherits": "linux-debug",
      "cacheVariables": {
        "SK_ENABLE_VULKAN": "ON",
        "VCPKG_MANIFEST_FEATURES": "vulkan"
      }
    },
    {
      "name": "windows-cadeditor-d3d11",
      "inherits": "windows-d3d11",
      "cacheVariables": {
        "SK_BUILD_CAD_EDITOR_LAB": "ON",
        "VCPKG_MANIFEST_FEATURES": "cadscene-runtime-test"
      }
    },
    {
      "name": "windows-cadeditor-d3d11-vs2022",
      "inherits": "windows-vs2022",
      "cacheVariables": {
        "SK_ENABLE_D3D11": "ON",
        "SK_BUILD_CAD_EDITOR_LAB": "ON",
        "VCPKG_MANIFEST_FEATURES": "cadscene-runtime-test"
      }
    },
    {
      "name": "windows-cadeditor-d3d12",
      "inherits": "windows-d3d12",
      "cacheVariables": {
        "SK_BUILD_CAD_EDITOR_LAB": "ON",
        "VCPKG_MANIFEST_FEATURES": "cadscene-runtime-test"
      }
    },
    {
      "name": "windows-cadeditor-d3d12-vs2022",
      "inherits": "windows-vs2022",
      "cacheVariables": {
        "SK_ENABLE_D3D12": "ON",
        "SK_BUILD_CAD_EDITOR_LAB": "ON",
        "VCPKG_MANIFEST_FEATURES": "cadscene-runtime-test"
      }
    },
    {
      "name": "windows-cadeditor-opengl",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "SK_BUILD_SMOKE_TEST": "OFF",
        "SK_ENABLE_OPENGL": "ON",
        "VCPKG_MANIFEST_FEATURES": "opengl;cadscene-runtime-test"
      }
    },
