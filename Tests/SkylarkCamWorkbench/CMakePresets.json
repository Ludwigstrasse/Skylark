    {
      "name": "windows-vulkan",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "SK_ENABLE_VULKAN": "ON",
        "VCPKG_MANIFEST_FEATURES": "vulkan"
      }
    },
    {
      "name": "linux-format-workbench-debug",
      "inherits": "dev-linux-debug",
      "cacheVariables": {
        "SK_BUILD_SMOKE_TEST": "OFF",
        "SK_BUILD_FORMAT_WORKBENCH": "ON",
        "SKFW_BUILD_CLI": "ON",
        "SKFW_BUILD_QT_APP": "OFF",
        "SK_BUILD_INSTALL": "OFF"
      }
    },
    {
      "name": "windows-format-workbench-vs2022",
      "inherits": "windows-vs2022",
      "cacheVariables": {
        "SK_BUILD_SMOKE_TEST": "OFF",
        "SK_BUILD_FORMAT_WORKBENCH": "ON",
        "SKFW_BUILD_CLI": "ON",
        "SKFW_BUILD_QT_APP": "ON",
        "SK_BUILD_INSTALL": "OFF"
      }
    }
  ],
  "buildPresets": [
